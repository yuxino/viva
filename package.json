{
  "name": "viva",
  "version": "2.0.6",
  "private": true,
  "description": "A quiet local workspace for Markdown.",
  "type": "module",
  "license": "MIT",
  "repository": "https://github.com/yuxino/viva",
  "scripts": {
    "branding:verify": "node scripts/verify-app-branding.mjs Viva",
    "check:size": "node scripts/check-size.mjs",
    "dev": "vite",
    "build": "pnpm branding:verify && tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:release": "node --test scripts/validate-updater-release.node-test.mjs && cargo test --locked --manifest-path tools/updater-verifier/Cargo.toml",
    "test:watch": "vitest",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "@tauri-apps/plugin-opener": "2.5.4",
    "@tauri-apps/plugin-process": "2.3.1",
    "@tauri-apps/plugin-updater": "2.11.0",
    "dompurify": "3.4.14",
    "highlight.js": "^11.12.0",
    "markdown-it": "15.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.0.1",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.12"
  }
}
