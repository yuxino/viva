{
  "$schema": "https://schema.tauri.app/config/2",
  "mainBinaryName": "Viva",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Viva",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ]
  },
  "bundle": {
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
